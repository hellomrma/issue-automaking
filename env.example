# 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# 글 생성 (필수 중 하나: 여기 또는 웹에서 직접 입력)
ANTHROPIC_API_KEY=sk-ant-...

# Claude 모델 (선택. 기본: claude-sonnet-5-5. 모델 404 시 여기서 변경)
# CLAUDE_MODEL=claude-sonnet-5-5

# CSV 트렌드 수집 사용 (선택. 기본: false)
# Chrome이 필요하고 느릴 수 있음. RSS보다 더 많은 키워드(~480개)를 가져옴
# USE_CSV_TRENDS=true

# 리버스 프록시(nginx 등) 뒤에서 실행할 때만 true (선택. 기본: false)
# true면 X-Forwarded-For 헤더로 요청 횟수 제한 대상을 구분함. 프록시 없이 켜면 제한을 우회당할 수 있음
# TRUST_PROXY=true

# 생성 이력 SQLite 경로 (선택. 기본: data/history.db)
# HISTORY_DB=data/history.db
